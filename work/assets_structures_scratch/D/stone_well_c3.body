// stone_well c3: a different reading. Rubble wall of individual rounded stones (low-poly
// dodecahedra, varied size and tint), flat cap slabs, and an A-frame of splayed legs each side
// carrying a beam with a pulley wheel.
export default function (THREE) {
  const g = new THREE.Group();
  const M = (color, name, rough = 0.85, extra = {}) => { const mt = new THREE.MeshStandardMaterial({ color, roughness: rough, metalness: 0, ...extra }); mt.name = name; return mt; };
  const stoneA = M(0xc9b48f, 'stone', 0.92), stoneB = M(0xb9a37e, 'stone', 0.95), capStone = M(0xd6c4a0, 'stone', 0.9);
  const core = M(0x8a7a5e, 'stone', 1.0, { side: THREE.DoubleSide });
  const dark = M(0x4a3324, 'timber'), timber = M(0x7a5534, 'timber', 0.85, { side: THREE.DoubleSide });
  const iron = M(0x3c3a38, 'metal', 0.6, { metalness: 0.5 }), rope = M(0xb89a68, 'fabric', 0.95), water = M(0x2c3a40, 'ground', 0.3);
  const add = (geo, mat, x, y, z, rx = 0, ry = 0, rz = 0) => { const ms = new THREE.Mesh(geo, mat); ms.position.set(x, y, z); ms.rotation.set(rx, ry, rz); g.add(ms); return ms; };
  const rock = new THREE.DodecahedronGeometry(0.16, 0);
  let seed = 7; const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
  const R = 0.72;
  for (let c = 0; c < 4; c++) {
    const n = 13;
    for (let i = 0; i < n; i++) {
      const a = (i + (c % 2) * 0.5 + rnd() * 0.15) / n * Math.PI * 2;
      const s = add(rock, rnd() < 0.5 ? stoneA : stoneB, Math.sin(a) * R, 0.11 + c * 0.2, Math.cos(a) * R, rnd(), a, rnd());
      s.scale.set(1.15 + rnd() * 0.2, 0.68 + rnd() * 0.1, 0.9);
      s.rotation.set(0, a, 0);
    }
  }
  add(new THREE.CylinderGeometry(0.66, 0.7, 0.82, 14, 1, true), core, 0, 0.41, 0);
  add(new THREE.CylinderGeometry(0.62, 0.62, 0.84, 14, 1, true), core, 0, 0.42, 0);
  // cap: flat slabs with rounded outer ends
  const NC = 8;
  for (let i = 0; i < NC; i++) {
    const a = i / NC * Math.PI * 2;
    const sl = add(new THREE.CylinderGeometry(0.21, 0.23, 0.16, 7), capStone, Math.sin(a) * 0.72, 0.9, Math.cos(a) * 0.72, 0, a, 0);
    sl.scale.set(1.4, 1, 1.0);
  }
  add(new THREE.CircleGeometry(0.62, 14), water, 0, 0.5, 0, -Math.PI / 2, 0, 0);
  // A-frames
  for (const sx of [-1, 1]) {
    for (const sz of [-1, 1]) add(new THREE.BoxGeometry(0.13, 2.6, 0.13), dark, sx * 1.0, 1.25, sz * 0.32, -sz * 0.13, 0, 0);
    add(new THREE.BoxGeometry(0.1, 0.1, 0.62), dark, sx * 1.0, 0.95, 0);
  }
  add(new THREE.BoxGeometry(2.3, 0.16, 0.16), dark, 0, 2.5, 0);
  // pulley under the beam
  add(new THREE.CylinderGeometry(0.17, 0.17, 0.07, 12), timber, 0, 2.25, 0, Math.PI / 2, 0, 0);
  add(new THREE.BoxGeometry(0.05, 0.3, 0.12), iron, 0.06, 2.33, 0);
  add(new THREE.BoxGeometry(0.05, 0.3, 0.12), iron, -0.06, 2.33, 0);
  add(new THREE.CylinderGeometry(0.02, 0.02, 0.85, 5), rope, 0.17, 1.83, 0);
  add(new THREE.CylinderGeometry(0.02, 0.02, 1.25, 5), rope, -0.17, 1.63, 0);
  // bucket on the long side of the rope, sitting on the cap
  add(new THREE.CylinderGeometry(0.17, 0.14, 0.3, 10, 1, true), timber, 0.17, 1.24, 0);
  add(new THREE.CircleGeometry(0.14, 10), timber, 0.17, 1.09, 0, Math.PI / 2, 0, 0);
  add(new THREE.TorusGeometry(0.165, 0.016, 4, 12), iron, 0.17, 1.34, 0, Math.PI / 2, 0, 0);
  add(new THREE.TorusGeometry(0.17, 0.014, 4, 10, Math.PI), iron, 0.17, 1.39, 0);
