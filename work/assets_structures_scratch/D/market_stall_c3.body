// market_stall c3: a different reading. Open trestle table on X legs with a raked two-tier
// display, a planked back wall carrying a shelf of jars (so the back is a real face), and a
// gabled-pitch awning whose front edge ends in pointed pennant flaps.
export default function (THREE) {
  const g = new THREE.Group();
  const M = (color, name, rough = 0.85, extra = {}) => { const mt = new THREE.MeshStandardMaterial({ color, roughness: rough, metalness: 0, ...extra }); mt.name = name; return mt; };
  const timber = M(0x7a5534, 'timber'), dark = M(0x4a3324, 'timber');
  const ochre = M(0xd9a441, 'fabric', 0.9, { side: THREE.DoubleSide }), madder = M(0xa8382e, 'fabric', 0.9, { side: THREE.DoubleSide });
  const fruitA = M(0xd9a441, 'foliage', 0.6), fruitB = M(0xc0603a, 'foliage', 0.6), pot = M(0xc0603a, 'tile', 0.8);
  const bx = (w, h, d, mat, x, y, z, rx = 0, ry = 0, rz = 0) => { const ms = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat); ms.position.set(x, y, z); ms.rotation.set(rx, ry, rz); g.add(ms); return ms; };
  const X = 1.12;
  // four posts, the back pair carrying a planked wall
  for (const sx of [-1, 1]) { bx(0.13, 2.3, 0.13, dark, sx * X, 1.15, 0.6); bx(0.13, 2.62, 0.13, dark, sx * X, 1.31, -0.6); bx(0.09, 0.09, 1.3, timber, sx * X, 2.15, 0); }
  bx(2.4, 0.11, 0.11, timber, 0, 2.25, 0.6);
  bx(2.4, 0.11, 0.11, timber, 0, 2.58, -0.6);
  for (let i = 0; i < 8; i++) bx(0.26, 1.7, 0.04, i % 2 ? timber : dark, -0.94 + i * 0.27, 1.25, -0.64);
  bx(2.2, 0.08, 0.06, dark, 0, 0.55, -0.62); bx(2.2, 0.08, 0.06, dark, 0, 1.95, -0.62);
  bx(2.2, 0.05, 0.25, timber, 0, 1.55, -0.5);
  // jars on the shelf
  const jar = new THREE.LatheGeometry([[0, 0], [0.07, 0], [0.1, 0.06], [0.1, 0.14], [0.05, 0.2], [0.055, 0.24], [0, 0.24]].map(([a, b]) => new THREE.Vector2(a, b)), 8);
  for (let i = 0; i < 6; i++) { const j = new THREE.Mesh(jar, pot); j.position.set(-0.85 + i * 0.34, 1.575, -0.5); g.add(j); }
  // trestle table: top + X legs at each end + stretcher
  bx(2.2, 0.07, 0.9, timber, 0, 0.92, 0.12);
  for (const sx of [-1, 1]) {
    bx(0.07, 1.1, 0.07, dark, sx * 0.95, 0.46, 0.12, 0.62, 0, 0);
    bx(0.07, 1.1, 0.07, dark, sx * 0.95, 0.46, 0.12, -0.62, 0, 0);
  }
  bx(1.9, 0.07, 0.07, dark, 0, 0.46, 0.12);
  // front skirt board
  bx(2.2, 0.2, 0.04, dark, 0, 0.8, 0.57);
  // raked two-tier display: a sloped tray (front low) and a rear riser
  bx(2.1, 0.05, 0.5, timber, 0, 1.02, 0.28, 0.25, 0, 0);
  bx(2.1, 0.2, 0.3, timber, 0, 1.05, -0.17);
  // fruit heaps: mounds of spheres
  const fg = new THREE.SphereGeometry(0.07, 7, 5);
  const heap = (x, y, z, mat, tilt) => {
    const rows = [[3, 3], [2, 2], [1, 1]];
    rows.forEach(([nx, nz], level) => { for (let i = 0; i < nx; i++) for (let k = 0; k < nz; k++) {
      const f = new THREE.Mesh(fg, mat);
      const lx = (i - (nx - 1) / 2) * 0.13, lz = (k - (nz - 1) / 2) * 0.13, ly = level * 0.1;
      f.position.set(x + lx, y + ly + 0.07 - lz * Math.sin(tilt), z + lz * Math.cos(tilt)); g.add(f);
    } });
  };
  heap(-0.65, 1.04, 0.3, fruitA, 0.25); heap(0.0, 1.04, 0.3, fruitB, 0.25); heap(0.65, 1.04, 0.3, fruitA, 0.25);
  heap(-0.45, 1.15, -0.17, fruitB, 0); heap(0.45, 1.15, -0.17, fruitA, 0);
  // awning: two pitches meeting at a ridge, front pitch long, back short over the wall
  const S = 6, sw = 2.6 / S;
  const pitch = (z0, y0, z1, y1) => {
    const len = Math.hypot(z1 - z0, y1 - y0), a = Math.atan2(y0 - y1, z1 - z0);
    for (let i = 0; i < S; i++) bx(sw, 0.03, len, i % 2 ? madder : ochre, -1.3 + (i + 0.5) * sw, (y0 + y1) / 2 + 0.03, (z0 + z1) / 2, a, 0, 0);
  };
  pitch(-0.25, 2.72, 0.95, 2.22); // front pitch, falling to the front
  pitch(-0.25, 2.72, -0.72, 2.56); // back pitch, falling to the back
  bx(2.6, 0.07, 0.07, timber, 0, 2.76, -0.25); // ridge pole
  // pennant flaps along the front edge
  const tri = new THREE.Shape([new THREE.Vector2(-sw / 2, 0), new THREE.Vector2(sw / 2, 0), new THREE.Vector2(0, -0.28)]);
  const tg = new THREE.ShapeGeometry(tri);
  for (let i = 0; i < S; i++) { const f = new THREE.Mesh(tg, i % 2 ? madder : ochre); f.position.set(-1.3 + (i + 0.5) * sw, 2.24, 0.96); g.add(f); }
