// market_stall c1: primitives. Four posts, plank counter, sloped striped awning of
// separate boxes with a straight valance, three open crates of fruit.
export default function (THREE) {
  const g = new THREE.Group();
  const M = (color, name, rough = 0.85, extra = {}) => { const mt = new THREE.MeshStandardMaterial({ color, roughness: rough, metalness: 0, ...extra }); mt.name = name; return mt; };
  const timber = M(0x7a5534, 'timber'), dark = M(0x4a3324, 'timber');
  const ochre = M(0xd9a441, 'fabric', 0.9, { side: THREE.DoubleSide }), madder = M(0xa8382e, 'fabric', 0.9, { side: THREE.DoubleSide });
  const fruitA = M(0xd9a441, 'foliage', 0.6), fruitB = M(0xc0603a, 'foliage', 0.6), leaf = M(0x6f7d3c, 'foliage', 0.8);
  const bx = (w, h, d, mat, x, y, z, rx = 0, ry = 0, rz = 0) => {
    const ms = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
    ms.position.set(x, y, z); ms.rotation.set(rx, ry, rz); g.add(ms); return ms;
  };
  const W = 2.4, X = 1.12;
  // posts: front 2.25, back 2.6
  for (const sx of [-1, 1]) {
    bx(0.12, 2.25, 0.12, dark, sx * X, 1.125, 0.55);
    bx(0.12, 2.6, 0.12, dark, sx * X, 1.3, -0.6);
    // side rail under awning + knee brace
    bx(0.08, 0.08, 1.25, timber, sx * X, 2.05, -0.03);
    bx(0.07, 0.07, 0.6, timber, sx * X, 1.75, 0.3, 0.8, 0, 0);
  }
  // top beam front and back
  bx(W, 0.1, 0.1, timber, 0, 2.2, 0.55);
  bx(W, 0.1, 0.1, timber, 0, 2.55, -0.6);
  // counter: top slab, front planks, side boards, back boards, shelf
  bx(2.36, 0.08, 1.0, timber, 0, 0.98, 0.0);
  bx(2.4, 0.06, 0.1, dark, 0, 1.0, 0.53);
  const n = 9;
  for (let i = 0; i < n; i++) {
    const x = -1.06 + (i + 0.5) * (2.12 / n);
    bx(2.12 / n - 0.02, 0.86, 0.04, i % 2 ? timber : dark, x, 0.5, 0.48);
  }
  bx(2.2, 0.08, 0.06, dark, 0, 0.75, 0.5);
  for (const sx of [-1, 1]) bx(0.04, 0.86, 0.95, timber, sx * 1.08, 0.5, -0.02);
  for (let i = 0; i < 3; i++) bx(2.16, 0.24, 0.04, i % 2 ? dark : timber, 0, 0.2 + i * 0.27, -0.52);
  bx(2.16, 0.05, 0.9, timber, 0, 0.12, -0.02);
  // awning: slope from back (y 2.62, z -0.66) to front (y 2.18, z 0.9)
  const zb = -0.66, yb = 2.62, zf = 0.9, yf = 2.18;
  const len = Math.hypot(zf - zb, yb - yf), a = Math.atan2(yb - yf, zf - zb);
  const S = 6, sw = 2.56 / S;
  for (let i = 0; i < S; i++) {
    const x = -1.28 + (i + 0.5) * sw, mat = i % 2 ? madder : ochre;
    bx(sw, 0.03, len, mat, x, (yb + yf) / 2 + 0.03, (zb + zf) / 2, a, 0, 0);
    // valance flap, slightly rounded bottom via a half cylinder
    bx(sw, 0.22, 0.02, mat, x, yf - 0.1, zf + 0.01);
    const cap = new THREE.Mesh(new THREE.CylinderGeometry(sw / 2, sw / 2, 0.02, 8, 1, false, Math.PI / 2, Math.PI), mat);
    cap.rotation.x = Math.PI / 2; cap.scale.set(1, 1, 0.45); cap.position.set(x, yf - 0.21, zf + 0.01); g.add(cap);
  }
  // goods: three crates with fruit
  const crate = (x, z, ry, mat, tilt) => {
    const c = new THREE.Group(); c.position.set(x, 1.02, z); c.rotation.set(tilt, ry, 0); g.add(c);
    const add = (w, h, d, px, py, pz, mt = timber) => { const b = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mt); b.position.set(px, py, pz); c.add(b); };
    add(0.6, 0.04, 0.42, 0, 0.02, 0);
    add(0.6, 0.18, 0.03, 0, 0.11, 0.2, dark); add(0.6, 0.18, 0.03, 0, 0.11, -0.2, dark);
    add(0.03, 0.18, 0.42, 0.29, 0.11, 0); add(0.03, 0.18, 0.42, -0.29, 0.11, 0);
    const sg = new THREE.SphereGeometry(0.075, 7, 5);
    for (let ix = 0; ix < 4; ix++) for (let iz = 0; iz < 3; iz++) {
      const f = new THREE.Mesh(sg, mat); f.position.set(-0.2 + ix * 0.135 + (iz % 2) * 0.02, 0.16 + ((ix + iz) % 2) * 0.03, -0.12 + iz * 0.12); c.add(f);
    }
    const lf = new THREE.Mesh(new THREE.ConeGeometry(0.05, 0.12, 4), leaf); lf.position.set(0.05, 0.27, 0); lf.rotation.z = 1.2; c.add(lf);
  };
  crate(-0.68, 0.05, 0.08, fruitA, 0.15);
  crate(0.0, -0.1, -0.05, fruitB, 0.0);
  crate(0.68, 0.08, 0.1, fruitA, 0.15);
